# ---------------------------------------------------------------------------
# AWS CDK
# ---------------------------------------------------------------------------
# 合成されたCloudFormationテンプレート・アセット（ビルド成果物）
cdk.out/
*.cdk.staging/
# cdk deploy 時に生成される一時ファイル
.cdk.staging/
# ルックアップ結果のキャッシュ。チームで値を固定したい場合はコミットする運用もある
cdk.context.json

# ※ cdk.json はプロジェクト設定なのでコミットすること

# ---------------------------------------------------------------------------
# AWS 認証情報・環境設定（絶対にコミットしない）
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
credentials
.aws/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# 仮想環境
.venv/
venv/
env/
ENV/
.python-version

# パッケージング / ビルド
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# テスト・カバレッジ
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
nosetests.xml

# 型チェック・リンター
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Lambda のローカル依存関係（デプロイ時にCDKが同梱するためコミット不要）
# ---------------------------------------------------------------------------
lambda/package/
lambda/.venv/
lambda/**/__pycache__/

# ---------------------------------------------------------------------------
# Node.js（CDK CLI を npx / ローカルインストールで使う場合）
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.npm/

# ---------------------------------------------------------------------------
# エディタ / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
